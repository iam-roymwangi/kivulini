APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# QUEUE_CONNECTION: use "sync" locally (jobs run inline, no worker needed).
# On production (cPanel) set to "database" — the scheduler cron drives queue:work.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_ADDRESS="info@kivulini.co.ke"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# M-Pesa Daraja (STK Push)
# Use sandbox credentials locally and live credentials on cPanel.
# APP_URL must be the public HTTPS origin (https://yourdomain.com) with no trailing slash.
# Generate the callback secret with: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# MPESA_CALLBACK_URL: leave blank on production — auto-generated from APP_URL + MPESA_CALLBACK_SECRET
#   via the webhooks.mpesa.stk route. APP_URL must be https://yourdomain.com on production.
#   For local sandbox testing, Daraja rejects http://localhost URLs with a 400. Set this to
#   any reachable HTTPS URL (e.g. https://yourdomain.com/webhooks/mpesa/stk/placeholder)
#   so sandbox accepts the request and sends the STK prompt. Use ngrok for real local callbacks.
# cPanel cron (every minute) so pending STK payments expire:
# * * * * * /usr/local/bin/php /home/USERNAME/path-to-app/artisan schedule:run >> /dev/null 2>&1
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_URL=
MPESA_CONNECT_TIMEOUT=5
MPESA_RESPONSE_TIMEOUT=20
MPESA_PENDING_TTL_MINUTES=15
MPESA_QUERY_AFTER_SECONDS=45
